# App
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8443

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AUB Registration Sync (optional)
AUB_REGISTRATION_URL=https://sturegss.aub.edu.lb/StudentRegistrationSsb
AUB_SYNC_TERM_CODE=202710
AUB_SYNC_INTERVAL_MS=600000
AUB_SYNC_ON_STARTUP=true

# Gemini API
# Get a key at https://aistudio.google.com/apikey. Never commit a real key.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: model used for the AI assistant (router + query generation + answers).
GEMINI_MODEL=gemini-3.6-flash

# Schedule Optimizer backend (optional) — POST /schedule-optimize
SCHEDULE_OPTIMIZER_URL=