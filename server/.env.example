# App
PORT=3000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8443

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AUB Registration Sync (optional)
AUB_REGISTRATION_URL=https://sturegss.aub.edu.lb/StudentRegistrationSsb
AUB_SYNC_TERM_CODE=202710
AUB_SYNC_INTERVAL_MS=600000
AUB_SYNC_ON_STARTUP=true

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333

# RAG Configuration
RAG_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
RAG_COLLECTION_NAME=knowledge_base
RAG_VECTOR_SIZE=384

# HuggingFace (free Inference API)
# Create a read token at https://huggingface.co/settings/tokens. Never commit a real token.
HF_API_TOKEN=your-hf-token
HF_MODEL=openai-community/gpt2

# Gemini API
# Get a key at https://aistudio.google.com/apikey. Never commit a real key.
GEMINI_API_KEY=your_gemini_api_key_here